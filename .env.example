# Copy to .env and fill in what you need. .env is git-ignored. Everything is optional
# for the local demo.

# --- IPFS -----------------------------------------------------------------
# Pinata JWT (pinata.cloud → API Keys). Leave empty to use the local IPFS folder
# frontend/public/ipfs/ (served by the portal), which is enough for the demo.
PINATA_JWT=
# Gateway used by the portal / demo-reveal to fetch ciphertexts when using Pinata.
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Sepolia (optional: npx hardhat run scripts/deploy.cjs --network sepolia) ---
SEPOLIA_RPC_URL=
# TESTNET ONLY! Use a throwaway wallet that has never held real funds.
DEPLOYER_PRIVATE_KEY=

# --- Exam parameters (used by demo-setup.mjs and deploy.cjs) ---------------
# Minimum stake per staff member, in ETH
MIN_STAKE=0.5
# Seconds after exam time during which staff can reveal their seeds
SEED_WINDOW=120
# Seconds after the paper is selected during which staff can reveal their pieces (PRD: 10 min)
REVEAL_WINDOW=600
# How far in the future demo-setup sets the exam (seconds of chain time)
EXAM_DELAY=120
